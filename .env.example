# CampusOS configuration. Copy to .env and fill in what you have.
# EVERYTHING IS OPTIONAL: anything left blank falls back (keywords, JSON file, logs, browser voice),
# so `npm start` always works. Restart the server after editing. Dashboard → Integrations shows what's live.

# ---- Server ----
PORT=3000
# Accounts: the first person to open /login on a fresh install creates the admin account.
# Google sign-in for students: Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised JavaScript origins: http://localhost:3000 and your PUBLIC_URL.
GOOGLE_CLIENT_ID=
# Optional: only accept student signups from this email domain, e.g. college.edu
COLLEGE_EMAIL_DOMAIN=
# "Load demo" creates 3 demo accounts (password campusos-demo1) and /login lists them. Set to off for any public demo.
DEMO_ACCOUNTS=
# Optional: lets scripts call admin APIs with the header x-admin-token (people use their own login instead).
ADMIN_TOKEN=
# Required Bearer token for MCP over HTTP (POST /mcp). Set it for anything public.
MCP_TOKEN=
# Public base URL (needed for Twilio signature checks), e.g. https://campusos.example.com or an ngrok URL
PUBLIC_URL=

# ---- LLM: Amazon Bedrock (preferred; wins if set) ----
# Bedrock console → API keys → generate a key. Enable model access for the model below.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# A vision-capable model/inference profile, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0 or us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=
# Embeddings for duplicate detection (default shown)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- LLM: any OpenAI-compatible API (used if Bedrock is not set) ----
#   OpenAI: https://api.openai.com/v1   Groq: https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional, enables embedding-based dedup on this provider (e.g. text-embedding-3-small)
EMBEDDING_MODEL=
# Cosine similarity needed to merge two reports (0-1)
DEDUP_THRESHOLD=0.86

# ---- Database + photos: Supabase ----
# Run docs/supabase.sql once, and create a PUBLIC storage bucket named `campusos`.
SUPABASE_URL=
# Service role key (server only; never put it in frontend code)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=campusos

# ---- Voice: ElevenLabs (Scribe speech-to-text + TTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Voice agent bubble on /report, /me and status pages (ElevenLabs → Agents → your agent; ID is in its URL). The agent must be public.
ELEVENLABS_AGENT_ID=

# ---- WhatsApp: Twilio ----
# Webhook: Twilio console → WhatsApp sandbox → "When a message comes in" = $PUBLIC_URL/api/whatsapp (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Email: any SMTP server (AWS SES SMTP, Gmail app password, ...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ESCALATION_EMAIL=hod@college.edu
